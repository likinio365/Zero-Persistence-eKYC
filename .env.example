# ── Fabric ─────────────────────────────────────────────────────────────────────
FABRIC_CHANNEL=kycchannel
FABRIC_CHAINCODE=kyccc
FABRIC_MSP_ID=Org1MSP
# Path to crypto material — overridden to /app/crypto-config inside Docker
FABRIC_CRYPTO_CONFIG_PATH=../fabric/crypto-config
FABRIC_AS_LOCALHOST=false
COUCHDB_USER=admin
COUCHDB_PASSWORD=Ch4ng3M3Now!

# ── Indy / ACA-Py ──────────────────────────────────────────────────────────────
# BCovrin public test ledger — internet access required at runtime.
# For a fully local ledger, run von-network and set to http://localhost:9000/genesis
INDY_GENESIS_URL=http://test.bcovrin.vonx.io/genesis
INDY_LEDGER_URL=https://test.bcovrin.vonx.io
# Generate: openssl rand -hex 32
ACAPY_WALLET_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2
ACAPY_API_KEY=
ACAPY_ENDPOINT=http://localhost:8030
ACAPY_TAILS_SERVER_BASE_URL=http://tails-server:6543
ACAPY_ADMIN_URL=http://acapy-agent:8031

POSTGRES_USER=acapy
POSTGRES_PASSWORD=Str0ngP@ssword!
POSTGRES_DB=acapy

# Populated automatically by acapy/scripts/provision.sh
# Re-run provision.sh after docker compose down -v
KYC_SCHEMA_NAME=kyc
KYC_SCHEMA_VERSION=3.0
KYC_CRED_DEF_TAG=default
KYC_CRED_DEF_ID=                    # filled in by provision.sh

# ── HashiCorp Vault ─────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root                     # dev mode only — use a real token in production
VAULT_ENABLED=true

# ── Encryption ─────────────────────────────────────────────────────────────────
# 64 hex chars = 32-byte AES-256 master key.
# Generate: openssl rand -hex 32
# NEVER change after first run — invalidates all existing IPFS documents.
ENCRYPTION_MASTER_KEY=f3e2d1c0b9a8f3e2d1c0b9a8f3e2d1c0b9a8f3e2d1c0b9a8f3e2d1c0b9a8f3e2

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=9z8y7x6w5v4u3t2s1r0q9z8y7x6w5v4u3t2s1r0q9z8y7x6w5v4u3t2s1r0q9z8y

# Applicant credentials
USER_USERNAME=applicant
USER_PASSWORD=Appl!c4ntPass#2024

# Verifier credentials
VERIFIER_USERNAME=reviewer
VERIFIER_PASSWORD=Rev!ewer$ecure#99

# Bank credentials
BANK_USERNAME=bankadmin
BANK_PASSWORD=B4nkS3cur3P@ss!

# ── Backend ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost

# ── ACA-Py Bank Agent ──────────────────────────────────────────────────────────
BANK_ACAPY_ADMIN_URL=http://bank-acapy:8041
BANK_ACAPY_ENDPOINT=http://localhost:8040

# ── Frontend ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3001
REACT_APP_API_URL=http://localhost
# Must match KYC_CRED_DEF_ID — rebuild frontend image after updating:
#   docker compose build frontend && docker compose up -d --force-recreate frontend
REACT_APP_CRED_DEF_ID=              # filled in by provision.sh (same as KYC_CRED_DEF_ID)

# ── Chaincode (CaaS) ────────────────────────────────────────────────────────────
# Package ID written by deploy-chaincode.sh — updated after each re-deploy
KYCCC_ID=                           # filled in by deploy-chaincode.sh
